# Copy values into .secrets/backend.properties via scripts/bootstrap-local.sh.
# Never commit real secrets.
DB_URL=jdbc:mariadb://localhost:3306/lostfound?useUnicode=true&characterEncoding=utf8
DB_USERNAME=lostfound
DB_PASSWORD=change-me
JWT_SECRET=base64-encoded-32-byte-minimum-secret
APP_HANDOVER_HMAC_SECRET=base64-encoded-32-byte-minimum-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://campuslost.localhost
APP_PHOTOS_DIR=uploads
APP_PHOTOS_STORAGE=filesystem
DB_VENDOR=mariadb
APP_DEMO_SEED=false
